[global]
    monitor = 0
    follow = mouse

    width = 360
    height = (0, 120)
    origin = top-right
    offset = (18, 42)
    notification_limit = 4

    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 0
    progress_bar_min_width = 160
    progress_bar_max_width = 320

    indicate_hidden = yes
    transparency = 0
    separator_height = 2
    padding = 14
    horizontal_padding = 16
    text_icon_padding = 12
    frame_width = 1
    gap_size = 8

    sort = yes
    idle_threshold = 120

    font = Inter 10
    line_height = 2
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = no

    icon_position = left
    min_icon_size = 24
    max_icon_size = 40
    icon_theme = Papirus-Dark
    icon_path = /usr/share/icons/Papirus-Dark/24x24/status:/usr/share/icons/Papirus-Dark/24x24/devices:/usr/share/icons/Papirus-Dark/24x24/apps:/usr/share/icons/Papirus-Dark/24x24/actions:/usr/share/icons/Papirus-Dark/24x24/mimetypes:/usr/share/icons/Papirus-Dark/24x24/places:/usr/share/icons/Papirus-Dark/32x32/status:/usr/share/icons/Papirus-Dark/32x32/devices:/usr/share/icons/Papirus-Dark/32x32/apps:/usr/share/icons/Papirus-Dark/32x32/actions:/usr/share/icons/Papirus-Dark/32x32/mimetypes:/usr/share/icons/Papirus-Dark/32x32/places:/usr/share/icons/Papirus-Dark/48x48/status:/usr/share/icons/Papirus-Dark/48x48/devices:/usr/share/icons/Papirus-Dark/48x48/apps:/usr/share/icons/Papirus-Dark/48x48/actions:/usr/share/icons/Papirus-Dark/48x48/mimetypes:/usr/share/icons/Papirus-Dark/48x48/places:/usr/share/icons/hicolor/24x24/apps:/usr/share/icons/hicolor/32x32/apps:/usr/share/icons/hicolor/48x48/apps:/usr/share/icons/hicolor/scalable/apps

    sticky_history = yes
    history_length = 20

    dmenu = /usr/bin/dmenu -p dunst:
    browser = /usr/bin/xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst
    corner_radius = 12
    ignore_dbusclose = false

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[experimental]
    per_monitor_dpi = false

[urgency_low]
    background = "#0d0d0d"
    foreground = "#e8e8e8"
    frame_color = "#2a2a2a"
    highlight = "#f5f5f5"
    timeout = 4

[urgency_normal]
    background = "#111111"
    foreground = "#f2f2f2"
    frame_color = "#3a3a3a"
    highlight = "#ffffff"
    timeout = 7

[urgency_critical]
    background = "#f4f4f4"
    foreground = "#050505"
    frame_color = "#ffffff"
    highlight = "#1a1a1a"
    timeout = 0

[fullscreen_delay_everything]
    fullscreen = delay
