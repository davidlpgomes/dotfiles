#!/usr/bin/sh

WEBAPP_BROWSER="helium-browser"
WEBAPPS_DIR="$HOME/webapps"

usage() {
    printf 'Uso: %s <site>\n' "${0##*/}" >&2
    printf 'Exemplo: %s calendar.google.com\n' "${0##*/}" >&2
}

if [ "$#" -ne 1 ]; then
    usage
    exit 2
fi

site=$1

case $site in
    *://*) url=$site ;;
    *) url="https://$site" ;;
esac

profile_name=${site#*://}
profile_name=${profile_name%%/*}

if [ -z "$profile_name" ]; then
    printf 'Erro: site invalido: %s\n' "$site" >&2
    exit 2
fi

profile_dir="$WEBAPPS_DIR/$profile_name"

mkdir -p "$profile_dir" || exit

exec "$WEBAPP_BROWSER" \
    "--app=$url" \
    "--user-data-dir=$profile_dir"
