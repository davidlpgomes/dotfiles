[
  {
    "include": "~/.config/waybar/shared.jsonc",
    "output": "!DP-2",
    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": [
      "group/audio",
      "custom/brightness",
      "group/hardware",
      "group/system",
      "privacy"
    ],
    "group/audio": {
      "orientation": "inherit",
      "modules": [
        "wireplumber",
        "wireplumber#source",
        "bluetooth"
      ]
    },
    "group/system": {
      "orientation": "inherit",
      "modules": [
        "network",
        "custom/updates",
        "battery",
        "tray"
      ]
    },
    "custom/brightness": {
      "min-length": 5,
      "format": "  {percentage}",
      "tooltip-format": "Brightness at {percentage}%",
      "exec": "$HOME/.config/waybar/scripts/brightness.py",
      "interval": 60,
      "signal": 9,
      "exec-on-event": false,
      "return-type": "json",
      "on-click": "$HOME/.config/waybar/scripts/brightness.py --step up && pkill -RTMIN+9 waybar",
      "on-click-right": "$HOME/.config/waybar/scripts/brightness.py --step down && pkill -RTMIN+9 waybar"
    },
    "custom/media": {
      "format": "{icon}  {text}",
      "return-type": "json",
      "max-length": 60,
      "format-icons": {
        "spotify": "",
        "default": "🎜"
      },
      "escape": true,
      "exec": "$HOME/.config/waybar/scripts/mediaplayer.py --player spotify 2> /dev/null",
      "on-click": "playerctl --player=spotify play-pause"
    },
    "custom/cpu": {
      "min-length": 4,
      "exec": "$HOME/.config/waybar/scripts/cpu_usage.sh",
      "interval": 3,
      "return-type": "json",
      "format": "󰍛  {}",
      "on-click": "ghostty --title=terminal-float -e btop"
    },
    "group/hardware": {
      "orientation": "horizontal",
      "modules": [
        "custom/cpu",
        "custom/memory",
        "custom/gpu",
        "custom/disk"
      ]
    },
    "custom/gpu": {
      "min-length": 4,
      "exec": "$HOME/.config/waybar/scripts/gpu_usage.sh",
      "interval": 10,
      "return-type": "json",
      "format": "󰢮  {}",
      "on-click": "ghostty --title=terminal-float -e watch -n 0.5 nvidia-smi"
    },
    "custom/memory": {
      "min-length": 4,
      "exec": "$HOME/.config/waybar/scripts/memory_usage.py",
      "interval": 5,
      "return-type": "json",
      "format": "   {}",
      "on-click": "ghostty --title=terminal-float -e btop"
    },
    "custom/disk": {
      "min-length": 4,
      "interval": 30,
      "format": "  {}",
      "path": "/",
      "exec": "$HOME/.config/waybar/scripts/disk_usage.sh",
      "return-type": "json",
      "on-click": "ghostty --title=terminal-float -e gdu /",
      "on-click-right": "ghostty --title=terminal-float -e yazi ~"
    },
    "network": {
      "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
      "format": "{icon}",
      "format-wifi": "{icon}",
      "format-ethernet": "󰈀",
      "format-disconnected": "󰤮",
      "tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
      "tooltip-format-ethernet": "{ifname}\nIP: {ipaddr}\nGateway: {gwaddr}\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
      "tooltip-format-disconnected": "Disconnected",
      "interval": 3,
      "spacing": 1,
      "on-click": ""
    },
    "custom/updates": {
      "min-length": 5,
      "exec": "$HOME/.config/waybar/scripts/updates.sh",
      "interval": 1800,
      "signal": 8,
      "exec-on-event": false,
      "return-type": "json",
      "format": "󰏖  {}",
      "on-click": "ghostty --title=terminal-float -e sh -c 'sudo pacman -Syu; pkill -RTMIN+8 waybar'",
      "on-click-right": "pkill -RTMIN+8 waybar"
    },
    "battery": {
      "format": "{capacity} {icon}",
      "format-discharging": "{icon}",
      "format-charging": "{icon}",
      "format-plugged": "",
      "format-icons": {
        "charging": ["󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
        "default": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
      },
      "format-full": "󰂅",
      "tooltip-format-discharging": "{power:>1.0f}W↓ {capacity}%",
      "tooltip-format-charging": "{power:>1.0f}W↑ {capacity}%",
      "interval": 5,
      "states": {
        "warning": 20,
        "critical": 10
      }
    },
    "bluetooth": {
      "format": "",
      "format-disabled": "󰂲",
      "format-connected": "󰂱  {num_connections}",
      "format-no-controller": "",
      "on-click": "ghostty --title=terminal-float -e bluetui",
      "tooltip-format": "{controller_alias}\t{controller_address}",
      "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
      "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}"
    },
    "wireplumber": {
      "format": "{icon}  {volume}",
      "format-muted": " ",
      "format-icons": {
        "default": ["", "", " "]
      },
      "on-click": "ghostty --title=terminal-float -e wiremix --tab output",
      "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
      "max-volume": 100,
      "scroll-step": 5
    },
    "wireplumber#source": {
      "node-type": "Audio/Source",
      "format": "󰍬 {volume}",
      "format-muted": "󰍭",
      "on-click": "ghostty --title=terminal-float -e wiremix --tab input",
      "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
      "scroll-step": 5
    },
    "tray": {
      "icon-size": 15,
      "spacing": 17,
      "show-passive-items": true
    },
    "privacy": {
      "icon-spacing": 12,
      "icon-size": 18,
      "transition-duration": 250,
      "modules": [
        {
          "type": "screenshare",
          "tooltip": true,
          "tooltip-icon-size": 24
        },
        {
          "type": "audio-in",
          "tooltip": true,
          "tooltip-icon-size": 24
        }
      ],
      "ignore-monitor": true
    }
  },
  {
    "include": "~/.config/waybar/shared.jsonc",
    "output": "DP-2",
    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": []
  }
]
